<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F9F9F6"
    android:padding="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="‹"
            android:textColor="#1F5C45"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Found Items"
            android:textColor="#1F5C45"
            android:textSize="23sp"
            android:textStyle="bold"
            android:paddingStart="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎁"
            android:textSize="23sp" />

    </LinearLayout>

    <!-- Search -->
    <EditText
        android:id="@+id/etSearchFound"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/edit_text_background"
        android:hint="🔍  Search found items..."
        android:padding="14dp"
        android:textColor="#183E31"
        android:textColorHint="#87958E"
        android:inputType="text" />

    <!-- Filters -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Category -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#EAF3EB"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📁"
                android:textSize="15sp" />

            <Spinner
                android:id="@+id/spinnerCategoryFound"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:spinnerMode="dropdown" />

        </LinearLayout>

        <Space
            android:layout_width="10dp"
            android:layout_height="1dp" />

        <!-- Location -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#EAF3EB"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍"
                android:textSize="15sp" />

            <Spinner
                android:id="@+id/spinnerLocationFound"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:spinnerMode="dropdown" />

        </LinearLayout>

    </LinearLayout>

    <!-- Result count -->
    <TextView
        android:id="@+id/tvFoundResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="✨ 0 found item(s) available"
        android:textColor="#68756E"
        android:textSize="12sp"
        android:paddingTop="8dp"
        android:paddingBottom="3dp" />

    <!-- Related Match -->
    <TextView
        android:id="@+id/tvFoundMatch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔗 Checking related lost matches..."
        android:textColor="#28704D"
        android:textSize="12sp"
        android:textStyle="bold"
        android:paddingBottom="8dp" />

    <!-- Found Items -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerFoundItems"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />

</LinearLayout>