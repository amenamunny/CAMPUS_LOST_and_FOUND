<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9F9F6"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- Header -->
        <LinearLayout
            android:id="@+id/headerSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="4dp">

            <ImageView
                android:id="@+id/ivHomeLogo"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:src="@mipmap/ic_launcher"
                android:scaleType="fitCenter"
                android:contentDescription="Campus Lost and Found Logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CAMPUS"
                    android:textColor="#1F5C45"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LOST &amp; FOUND"
                    android:textColor="#D88B5A"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔔"
                android:textSize="22sp"
                android:padding="8dp" />

        </LinearLayout>


        <!-- Welcome Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/welcomeCard"
            android:layout_width="match_parent"
            android:layout_height="105dp"
            android:layout_marginTop="18dp"
            app:cardBackgroundColor="#E7F2E8"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Welcome back"
                        android:textColor="#1F5C45"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <ImageView
                    android:id="@+id/ivWelcomeBackpack"
                    android:layout_width="75dp"
                    android:layout_height="75dp"
                    android:src="@drawable/ic_backpack_navy"
                    android:contentDescription="Backpack"
                    android:scaleType="fitCenter" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- Section Title -->
        <TextView
            android:id="@+id/tvQuickActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="What would you like to do?"
            android:textColor="#23483A"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="12dp" />


        <!-- First Row -->
        <LinearLayout
            android:id="@+id/actionRowOne"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Report Lost -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardReportLost"
                android:layout_width="0dp"
                android:layout_height="145dp"
                android:layout_weight="1"
                android:layout_marginEnd="7dp"
                app:cardBackgroundColor="#FDE8DF"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔎"
                        android:textSize="38sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnReportLost"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Report Lost"
                        android:textAllCaps="false"
                        android:textColor="#A84F36"
                        android:textSize="14sp"
                        android:backgroundTint="#FDE8DF"
                        app:cornerRadius="16dp"
                        app:strokeWidth="0dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- Report Found -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardReportFound"
                android:layout_width="0dp"
                android:layout_height="145dp"
                android:layout_weight="1"
                android:layout_marginStart="7dp"
                app:cardBackgroundColor="#E3F3E8"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎁"
                        android:textSize="38sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnReportFound"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Report Found"
                        android:textAllCaps="false"
                        android:textColor="#28704D"
                        android:textSize="14sp"
                        android:backgroundTint="#E3F3E8"
                        app:cornerRadius="16dp"
                        app:strokeWidth="0dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>


        <!-- Second Row -->
        <LinearLayout
            android:id="@+id/actionRowTwo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="14dp">

            <!-- Lost Items -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLostItems"
                android:layout_width="0dp"
                android:layout_height="145dp"
                android:layout_weight="1"
                android:layout_marginEnd="7dp"
                app:cardBackgroundColor="#E4F0F7"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <ImageView
                        android:layout_width="65dp"
                        android:layout_height="65dp"
                        android:src="@drawable/ic_backpack_navy"
                        android:contentDescription="Lost Items"
                        android:scaleType="fitCenter" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLostItems"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Lost Items"
                        android:textAllCaps="false"
                        android:textColor="#285B72"
                        android:textSize="14sp"
                        android:backgroundTint="#E4F0F7"
                        app:cornerRadius="16dp"
                        app:strokeWidth="0dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- Found Items -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardFoundItems"
                android:layout_width="0dp"
                android:layout_height="145dp"
                android:layout_weight="1"
                android:layout_marginStart="7dp"
                app:cardBackgroundColor="#EEE8F7"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📦"
                        android:textSize="38sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFoundItems"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Found Items"
                        android:textAllCaps="false"
                        android:textColor="#66518A"
                        android:textSize="14sp"
                        android:backgroundTint="#EEE8F7"
                        app:cornerRadius="16dp"
                        app:strokeWidth="0dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>


        <!-- Search / Browse Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/searchCard"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="18dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="18dp"
            app:cardElevation="1dp"
            app:strokeColor="#DDE8E0"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔍"
                    android:textSize="22sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="12dp"
                    android:text="Search items..."
                    android:textColor="#718078"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="☷"
                    android:textColor="#28704D"
                    android:textSize="24sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- Profile -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnProfile"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="16dp"
            android:text="👤   My Profile"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:backgroundTint="#28704D"
            app:cornerRadius="18dp" />


        <!-- Bottom Navigation -->
        <LinearLayout
            android:id="@+id/bottomNavigation"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:background="#FFFFFF"
            android:elevation="3dp">

            <TextView
                android:id="@+id/navHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="🏠\nHome"
                android:textColor="#28704D"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/navLost"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="🎒\nLost"
                android:textColor="#68756E"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/navFound"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="🎁\nFound"
                android:textColor="#68756E"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/navProfile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="👤\nProfile"
                android:textColor="#68756E"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>