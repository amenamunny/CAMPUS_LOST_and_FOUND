<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="18dp"
    app:cardElevation="1dp"
    app:strokeColor="#E1E9E3"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="13dp">

        <!-- Item Icon -->
        <TextView
            android:id="@+id/tvReportIcon"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:background="#EAF3EB"
            android:gravity="center"
            android:text="🎒"
            android:textSize="23sp" />

        <!-- Item Information -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="6dp">

            <TextView
                android:id="@+id/tvReportItemName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Black Backpack"
                android:textColor="#183E31"
                android:textSize="16sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvReportCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="📁 Bags"
                android:textColor="#68756E"
                android:textSize="12sp"
                android:maxLines="1" />

            <TextView
                android:id="@+id/tvReportLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📍 Library"
                android:textColor="#68756E"
                android:textSize="12sp"
                android:maxLines="1" />

            <TextView
                android:id="@+id/tvReportDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📅 12 Sep 2026"
                android:textColor="#68756E"
                android:textSize="12sp"
                android:maxLines="1" />

            <!-- Report Status -->
            <TextView
                android:id="@+id/tvReportStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:background="#EAF3EB"
                android:text="🟢 Active"
                android:textColor="#1F5C45"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Mark as Resolved Button -->
            <TextView
                android:id="@+id/btnResolveReport"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginTop="7dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:gravity="center"
                android:background="#1F5C45"
                android:text="✅ Mark as Resolved"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <!-- Edit Report Button -->
            <TextView
                android:id="@+id/btnEditReport"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginTop="6dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:gravity="center"
                android:background="#EAF3EB"
                android:text="✏️ Edit Report"
                android:textColor="#1F5C45"
                android:textSize="12sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <!-- Delete Button -->
        <TextView
            android:id="@+id/btnDeleteReport"
            android:layout_width="38dp"
            android:layout_height="42dp"
            android:gravity="center"
            android:text="🗑️"
            android:textSize="20sp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Delete report" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>